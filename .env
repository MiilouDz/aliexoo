# ---- إعدادات المراقبة ----
# قنوات مصدر الجزائر (روابط/عروض صالحة للجزائر) — سيُضاف علم 🇩🇿 تلقائيا لكل منشور منها
SOURCE_CHANNELS_DZ=@Alibestecon,@cpndcc,@Alieexdeals,@SALEXPRESSCHATDZ
# قنوات مصدر فرنسا — سيُضاف علم 🇫🇷 تلقائيا لكل منشور منها
SOURCE_CHANNELS_FR=@France_HotDeals,@offersFrance,@alixochannel
# يمكنك تخصيص نص/علم كل منطقة إذا أردت (اختياري، القيمة الافتراضية هي العلم فقط)
# DZ_TAG=🇩🇿
# FR_TAG=🇫🇷

# قناتك التي سيتم النشر فيها
TARGET_CHANNEL=@AliXPromotion

# اختياري
INCLUDE_SPECIAL_OFFERS=1
POST_DELAY_SECONDS=2
KEEP_ALIVE=0

# ---- خاصة بمراقب القنوات (aliexpress_service.py) ----
# هل تريد معالجة الرسائل القديمة عند أول تشغيل لقناة جديدة؟ (0 = لا، تبدأ من الآن فقط)
BACKFILL_ON_FIRST_RUN=0
# إذا فعّلت الخيار أعلاه، كم رسالة قديمة يعالجها كحد أقصى
BACKFILL_LIMIT=50
# عند العودة بعد توقف، أقصى عدد رسائل "فائتة" يعالجها دفعة واحدة (حماية من الإغراق)
MAX_CATCHUP=200
# أين يُحفظ آخر رسالة تمت معالجتها لكل قناة (حتى لا تُعاد معالجتها)
STATE_FILE=channel_state.json
